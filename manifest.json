{
  "name": "VortexPro",
  "version": "2.5",
  "manifest_version": 3,
  "description": "2.5 Pre-Alpha 05.07.2026",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "update_url": "https://klingri.github.io/VortexPro/updates.xml",
  "host_permissions": [
    "https://pastebin.com/*",
    "https://playvortex.io/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://playvortex.io/*"
      ],
      "css": [
        "content/website/content.css",
        "content/website/themes.css",
        "content/header/header.css"
      ],
      "js": [
        "content/website/content.js",
        "content/website/themes.js",
        "content/website/background.js",
        "content/header/header.js",
        "content/pages/settings.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/website/content.css",
        "images/*.png",
        "assets/fonts/*"
      ],
      "matches": [
        "https://playvortex.io/*"
      ]
    }
  ]
}