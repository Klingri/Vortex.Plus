{
  "name": "Vortex+",
  "version": "1.4",
  "manifest_version": 3,
   "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "css": [
        "styles/main.css"
      ]
    },
    {
      "matches": [
        "https://vortex.towerstats.com/search*"
      ],
      "js": [
        "scripts/search.js"
      ]
    },
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "js": [
        "scripts/features/injectshaders.js",
        "scripts/features/injectmaploader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/features/shaders.js",
        "scripts/features/maploader.js"
      ],
      "matches": [
        "https://vortex.towerstats.com/*"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}