{
  "name": "VortexPro",
  "version": "2.4",
  "manifest_version": 3,
  "description": "2.4 Pre-Alpha 01.07.2026",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "update_url": "https://klingri.github.io/VortexPro/updates.xml",
  "options_ui": {
    "page": "settings/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://pastebin.com/*",
    "https://playvortex.io/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playvortex.io/*"
      ],
      "css": [
        "content/website/content.css",
        "content/website/themes.css",
        "content/header/header.css"
      ],
      "js": [
        "content/website/content.js",
        "content/website/themes.js",
        "content/website/background.js",
        "content/header/header.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/website/content.css",
        "images/*.png",
        "cursors/*",
        "https://cdn.discordapp.com/attachments/1501231549524213863/1502435875689201695/Untitled.png?ex=6a005cb2&is=69ff0b32&hm=b5a48762194b1aaf9054570b527617ed841a5b748f3acaf3fc66eeecd9322125.jpg*",
        "assets/fonts/*",
        "settings/options.html"
      ],
      "matches": [
        "https://playvortex.io/*"
      ]
    }
  ]
}