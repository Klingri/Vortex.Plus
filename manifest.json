{
  "name": "Vortex+",
  "version": "2.0",
  "manifest_version": 3,
  "description": "Open Source -- 2.0 Alpha",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "update_url": "https://klingri.github.io/Vortex.Plus/updates.xml",
  "options_ui": {
    "page": "settings/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://pastebin.com/*",
    "https://vortex.towerstats.com/"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "css": [
        "styles/content.css",
        "styles/themes.css"
      ],
      "js": [
        "scripts/modules/music-player.js",
        "scripts/modules/themes.js",
        "scripts/modules/staff-icon.js",
        "scripts/modules/background.js",
        "scripts/modules/inject-icon.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://vortex.towerstats.com/search*"
      ],
      "js": [
        "scripts/search.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/content.css",
        "images/*.png",
        "cursorpack/*.Alternate Select.cur",
        "cursorpack/*.Busy.ani",
        "cursorpack/*.Diagonal Resize 1.cur",
        "cursorpack/*.Diagonal Resize 2.cur",
        "cursorpack/*.HandWriting.cur",
        "cursorpack/*.Help Select.cur",
        "cursorpack/*.Horizontal Resize.cur",
        "cursorpack/*.Link Select.cur",
        "cursorpack/*.Location Select.cur",
        "cursorpack/*.Move.cur",
        "cursorpack/*.Normal Select.cur",
        "cursorpack/*.Person Select.cur",
        "cursorpack/*.Precision Select.cur",
        "cursorpack/*.Unavailable.cur",
        "cursorpack/*.Text Select.cur",
        "cursorpack/*.Vertical Resize.cur",
        "cursorpack/*.Working in Background.ani",
        "https://cdn.discordapp.com/attachments/1501231549524213863/1502435875689201695/Untitled.png?ex=6a005cb2&is=69ff0b32&hm=b5a48762194b1aaf9054570b527617ed841a5b748f3acaf3fc66eeecd9322125.jpg*",
        "assets/fonts/*",
        "settings/options.html"
      ],
      "matches": [
        "https://vortex.towerstats.com/*"
      ]
    }
  ]
}