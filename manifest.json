{
  "name": "BetterVortex",
  "version": "3.0",
  "manifest_version": 3,
  "description": "3.0 Pre-Alpha 05.08.2026",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "host_permissions": [
    "https://pastebin.com/*",
    "https://playvortex.io/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://playvortex.io/*"
      ],
      "css": [
        "content/base/reset.css",
        "content/base/typography.css",
        "content/components/buttons.css",
        "content/components/cards.css",
        "content/components/header.css",
        "content/features/themes.css",
        "content/pages/home/home.css",
        "content/pages/profile/profile.css",
        "content/pages/catalog/catalog.css",
        "content/pages/banpage/banpage.css",
        "content/pages/game/game.css",
        "content/pages/settings/settings.css",
        "content/main.css"
      ],
      "js": [
        "content/base/reset.js",
        "content/base/typography.js",
        "content/components/buttons.js",
        "content/components/cards.js",
        "content/components/header.js",
        "content/features/themes.js",
        "content/pages/home/home.js",
        "content/pages/banpage/banpage.js",
        "content/pages/catalog/catalog.js",
        "content/pages/game/game.js",
        "content/pages/profile/profile.js",
        "content/pages/settings/settings.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/website/content.css",
        "images/*.png",
        "assets/fonts/*"
      ],
      "matches": [
        "https://playvortex.io/*"
      ]
    }
  ]
}