{
  "name": "Vortex Extension",
  "version": "1.2",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "matches": [
        "https://vortex.towerstats.com/search*"
      ],
      "js": [
        "UserSearch.js"
      ]
    },
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "js": [
        "injectShader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/Shader.js"
      ],
      "matches": [
        "https://vortex.towerstats.com/*"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}