{
  "name": "Vortex+",
  "version": "1.9",
  "manifest_version": 3,
  "description": "Vortex, but Bigger.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "update_url": "https://klingri.github.io/Vortex.Plus/updates.xml",
  "options_ui": {
    "page": "settings/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://pastebin.com/*",
    "https://vortex.towerstats.com/"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vortex.towerstats.com/*"
      ],
      "css": [
        "styles/main.css",
        "styles/menu-themes.css"
      ],
      "js": [
        "scripts/features/musicplayer.js",
        "scripts/features/theme-manager.js",
        "scripts/features/stafficon.js",
        "scripts/features/snowparticles.js",
        "scripts/features/background.js",
        "scripts/features/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://vortex.towerstats.com/search*"
      ],
      "js": [
        "scripts/search.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/main.css",
        "images/*.png",
        "assets/fonts/*",
        "settings/options.html"
      ],
      "matches": [
        "https://vortex.towerstats.com/*"
      ]
    }
  ]
}